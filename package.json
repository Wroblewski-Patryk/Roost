{
  "name": "companycore",
  "version": "0.1.0",
  "private": true,
  "description": "LuckySparrow Company Core v1 backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "node --stack_size=8192 ./node_modules/typescript/bin/tsc",
    "build:web": "node scripts/clean-react-build.mjs && vite build",
    "brand:assets": "node scripts/generate-web-brand-assets.mjs",
    "typecheck": "node --stack_size=8192 node_modules/typescript/bin/tsc --noEmit",
    "lint": "npm run check:public-js && npm run check:route-capabilities",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:soar-graph": "tsx scripts/import-soar-application-graph.ts",
    "import:application-docs": "tsx scripts/import-application-documentation-context.ts",
    "import:application-docs:local-preview": "tsx scripts/import-application-documentation-context.ts --local-preview",
    "import:application-docs:apply": "tsx scripts/import-application-documentation-context.ts --apply",
    "import:aviary-legacy-context:preview": "tsx scripts/import-application-documentation-context.ts --application=aviary --source=aviary-legacy-assumptions --documents-only",
    "import:aviary-legacy-context:apply": "tsx scripts/import-application-documentation-context.ts --application=aviary --source=aviary-legacy-assumptions --documents-only --apply",
    "adapter:smoke": "node scripts/adapter-smoke.mjs",
    "agent:training-smoke": "node scripts/agent-training-smoke.mjs",
    "agent:codex-host": "node scripts/roost-codex-agent-host.mjs",
    "agent:codex-host:check": "node scripts/validate-roost-agent-host-config.mjs",
    "test:agent-host-guard": "node --test scripts/agent-host-workspace-guard.test.mjs",
    "test:agent-host-lease": "node --test scripts/agent-host-execution-lease.test.mjs",
    "test:agent-host-writer": "node --test scripts/agent-host-writer-lock.test.mjs",
    "test:agent-host-packet": "node --test scripts/agent-host-execution-packet.test.mjs",
    "test:agent-host-recovery": "node --test scripts/agent-host-recovery.test.mjs",
    "owner-console:ux-smoke": "node scripts/owner-console-ux-smoke.mjs",
    "company-os:trace-smoke": "node scripts/company-os-lifecycle-trace-smoke.mjs",
    "operating-model:registry-smoke": "node scripts/operating-model-registry-lifecycle-smoke.mjs",
    "mcp:server": "node scripts/companycore-mcp-server.mjs",
    "mcp:smoke": "node scripts/companycore-mcp-smoke.mjs",
    "ai-ready:smoke": "node scripts/companycore-ai-ready-smoke.mjs",
    "aog:deploy-smoke": "node scripts/aog-deploy-smoke.mjs",
    "google-drive:smoke": "node scripts/google-drive-production-smoke.mjs",
    "clickup:bootstrap": "node scripts/clickup-production-bootstrap.mjs",
    "evidence:retention:check": "node scripts/ignored-evidence-retention-guardrail.mjs",
    "test:evidence-retention": "node scripts/ignored-evidence-retention-guardrail.test.mjs",
    "test:application-graph-layout": "tsx --test web/src/features/departments/application-graph-layout.test.ts",
    "test:application-graph-motion": "tsx --test web/src/features/departments/application-graph-motion.test.ts",
    "test:company-graph-layout": "tsx --test web/src/features/departments/company-graph-layout.test.ts",
    "test:unified-graph-layout": "tsx --test web/src/components/graph/unified-graph-layout.test.ts web/src/components/graph/unified-graph-selection.test.ts web/src/components/graph/unified-graph-interaction.test.ts",
    "check:public-js": "node -e \"console.log('legacy public JS removed; React/Vite build is the web syntax gate')\"",
    "check:route-capabilities": "node scripts/check-route-capabilities.mjs",
    "test:api": "npm run build && npm run prisma:migrate:deploy && node --test \"dist/tests/api.test.js\"",
    "test:api:local": "node scripts/test-api-local.mjs",
    "test": "npm run test:api",
    "validate": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "^12.11.5",
    "cors": "^2.8.5",
    "daisyui": "^5.5.19",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.0",
    "three": "0.182.0",
    "vite": "^8.0.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.59.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
