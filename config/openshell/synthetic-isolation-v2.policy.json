{
  "version": 1,
  "filesystem_policy": {
    "include_workdir": false,
    "read_only": [
      "/opt/roost-fixture/bin/fake-app-server"
    ],
    "read_write": [
      "/sandbox/roost-fixture/scratch"
    ]
  },
  "landlock": {
    "compatibility": "hard_requirement"
  },
  "process": {
    "run_as_user": "sandbox",
    "run_as_group": "sandbox"
  },
  "network_policies": {
    "synthetic_probe": {
      "name": "synthetic-probe-v2",
      "endpoints": [
        {
          "host": "fixture.roost.test",
          "port": 18080,
          "protocol": "rest",
          "enforcement": "enforce",
          "rules": [
            {
              "allow": {
                "method": "GET",
                "path": "/probe"
              }
            }
          ]
        }
      ],
      "binaries": [
        {
          "path": "/opt/roost-fixture/bin/fake-app-server"
        }
      ]
    }
  },
  "network_middlewares": {}
}
