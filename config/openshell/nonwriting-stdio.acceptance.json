  "evidenceLevels": [
    {
      "id": "unit-property",
      "requires": [],
      "proof": "Official release-bound tests of parsing, negotiation, immutable identity, policy invariants and generated negative permutations. No implementation inferred from local proposal tests."
    },
    {
      "id": "fake-daemon",
      "requires": [
        "unit-property"
      ],
      "proof": "Official Docker fake-daemon snapshots assert the exact HostConfig/mount/resource/lifecycle request and reject daemon response drift. No real runtime proof."
    },
    {
      "id": "prepared-integration",
      "requires": [
        "unit-property",
        "fake-daemon"
      ],
      "proof": "Separately authorized real official supervisor setup and independent trusted inspection of a prepared child context with exec latch closed. No model or fixture ELF execution. Observe mounts, identity, FDs, kernel enforcement and reject injected defects before workload exec."
    },
    {
      "id": "live-adversarial",
      "requires": [
        "unit-property",
        "fake-daemon",
        "prepared-integration"
      ],
      "proof": "Separately authorized adversarial test binary/behavior revision on exact qualified host. Demonstrate denied writes/network/admin/secondary exec, enforced output and descendant stop, crash/replay failures. Existing stdio fixture cannot claim these behaviors."
    }
