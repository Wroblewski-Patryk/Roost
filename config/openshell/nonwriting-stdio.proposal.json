{
  "schemaVersion": 1,
  "proposalId": "openshell.docker-nonwriting-stdio.proposal.v1",
  "status": "local-proposal-only",
  "profile": {
    "id": "docker_nonwriting_stdio",
    "version": 1,
    "defaultEnabled": false,
    "requiredParticipants": [
      "gateway",
      "driver",
      "supervisor"
    ],
    "requiredAcknowledgement": "exact-profile-version-contract-hash",
    "downgradeAllowed": false,
    "upstreamNameReserved": false
  },
  "upstreamCommit": "d1155aa70042d3e2ee49dbfa15346b108b7c1d92",
  "requirements": [
    {
      "id": "negotiation",
      "must": "Explicit opt-in profile id/version and contract hash must be acknowledged by gateway, selected driver and actual supervisor build. Missing, false, unknown version, partial support or ignored required fields denies preparation and exec.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "root",
      "must": "Docker HostConfig.ReadonlyRootfs must be true. Independently observe the child root and complete mount namespace read-only before workload exec; no later remount or mount propagation may widen it.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "mounts",
      "must": "No user bind, named/anonymous volume, image VOLUME or child-visible writable mount, device, socket or writable file backing. Include implicit proc/sys/dev/shm, hosts/resolver, tmp/home/cache/log/state paths. Unknown, hidden or truncated enumeration denies.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "workspace",
      "must": "workspaceMode none bypasses creation, chown/chmod, write probes, extraction, upload, copy and sync. Explicit canonical absolute cwd must exist as an immutable directory; no image WORKDIR, empty-path or /sandbox fallback and no implicit HOME/XDG.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "command",
      "must": "Require explicit nonempty argv and tty false; argv[0] is the approved image-baked static ELF. No shell, image ENTRYPOINT/CMD, login-shell default, interpreter, dynamic loader, secondary exec or writable/memfd executable.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "artifact",
      "must": "Require OCI platform-manifest digest and exact platform, verified layer/config closure and final file membership before start. Fixture is a regular ELF with exact path/mode/uid/gid/size/SHA256, nlink 1, no symlink ancestors, hardlink, device, file capabilities or setid. Recheck same immutable object in final namespace; no execution to identify it.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "isolation",
      "must": "Child is nonroot with explicit numeric UID/GID, no supplementary groups or capabilities, no_new_privs and mandatory confinement. It cannot reach control-plane processes, namespaces, sockets, credentials, host paths or APIs through proc, shared memory, ptrace, signal, IPC or inherited resources.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "network",
      "must": "Child network is disabled, with zero authored/effective rules, inference, DNS, middleware, proxy baseline/routes and host gateway access. No GPU requests/devices/environment, including nvidiactl and dxg; absence must be observed.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "descriptors",
      "must": "At exec only dedicated anonymous stdio pipes 0/1/2 remain, with exact access modes and bounded capture. No socket, token, directory, namespace, device, executable or control FD survives. Setup/barrier/error descriptors close before exec; CLOEXEC assertion alone is insufficient evidence.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "supervisor-state",
      "must": "Trusted supervisor may keep necessary bounded private tmpfs/state in its separate namespace, with no propagation or path/FD/proc-root route into child. Report every control mount and its byte/inode limits, owner and visibility. Gateway daemon privilege is never child authority.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "policy",
      "must": "Require one explicit full policy snapshot, hard Landlock and exact post-loader semantics; no merge, enrichment, global/provider layers, disk defaults, OPA fallback, updates or workdir grants. Observe installed enforcement and hash the post-loader snapshot; input policy presence is insufficient.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "limits",
      "must": "Require finite enforced CPU, RAM, no-extra-swap, PID, setup/wall/termination deadlines, supervisor-state byte/inode and aggregate stdout/stderr/input bounds. Exceeding or unavailable enforcement aborts preparation or terminates the attempt without success; no unbounded logger/telemetry queue.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "lifecycle",
      "must": "Single-use prepare receipt and explicit start acknowledgement; no automatic restart/resume/recovery into retained mutable state. Stop/crash cancels receipt. Retry requires a new attempt, fresh private state and full proof. Cleanup touches only owned resources; unknown cleanup blocks reuse without host repair.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "receipt",
      "must": "Trusted observers seal actual prepared state before workload spawn/exec. Return a bounded provider-neutral receipt bound to caller nonce, request hash, attempt and instance generation. Verify authenticated provenance, build identities, evidence qualification and exact receipt hash acknowledgement; never accept caller self-assertion.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "compatibility",
      "must": "Profile is disabled by default. Existing additive protobuf compatibility remains for ordinary mode; explicit required profile cannot be ignored or downgraded. Old behavior is preserved but ineligible. No automatic data migration or change to existing sandboxes.",
      "failure": "DENY_WORKLOAD_EXEC"
    },
    {
      "id": "evidence",
      "must": "Source/config review and capability advertisement never qualify implementation. Require official release-bound unit/property, fake-daemon, prepared-container integration and separately authorized adversarial evidence on the exact supported platform; unsupported Docker/WSL or missing level denies qualification.",
      "failure": "DENY_WORKLOAD_EXEC"
    }
  ],
