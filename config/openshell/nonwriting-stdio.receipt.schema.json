              "minimum": 1,
              "maximum": 4096
            },
            "setupTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "workloadTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "terminationTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "inputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "stdoutBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "stderrBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "totalCaptureBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "supervisorStateBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            },
            "supervisorStateInodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "logDriver": {
              "const": "none"
            },
            "observedEnforced": {
              "const": true
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "restart",
            "recovery",
            "singleUse",
            "ownedCleanupContractSha256",
            "retainedMutableState"
          ],
          "properties": {
            "restart": {
              "const": "no"
            },
            "recovery": {
              "const": "new-attempt-only"
            },
            "singleUse": {
              "const": true
            },
            "ownedCleanupContractSha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "retainedMutableState": {
              "const": false
            }
          }
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "keyId",
        "algorithm",
        "signature"
      ],
      "properties": {
        "role": {
          "enum": [
            "gateway",
            "driver",
            "supervisor"
          ]
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
