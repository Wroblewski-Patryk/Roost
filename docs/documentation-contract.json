{
  "schemaVersion": 1,
  "project": "Roost",
  "entrypoint": "docs/README.md",
  "defaultAgentContext": [
    "docs/README.md",
    "docs/product/product.md",
    "docs/architecture/architecture-source-of-truth.md",
    "docs/status/project-truth-index.json"
  ],
  "authority": {
    "product": ["docs/product/"],
    "architecture": ["docs/architecture/", "docs/decisions/"],
    "operations": ["docs/operations/"],
    "activePlanning": ["docs/planning/open-decisions.md", "docs/planning/mvp-next-commits.md"],
    "derivedStatus": ["docs/status/"],
    "historical": ["history/"]
  },
  "excludedFromDefaultContext": [
    "history/",
    "docs/graphs/",
    "docs/obsidian/",
    "docs/maps/"
  ],
  "budgets": {
    "maxDefaultContextBytes": 150000,
    "maxActiveStateFileBytes": 256000,
    "maxActivePlanningFileBytes": 256000,
    "maxActivePlanningFiles": 40,
    "maxTruthAgeHours": 24
  }
}
